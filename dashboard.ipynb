        "# Using direct Google Maps tiles to avoid watermarks and 403 errors\n",
        "m = folium.Map(\n",
        "    location=map_center,\n",
        "    zoom_start=14,\n",
        "    tiles='https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}',\n",
        "    attr='Google Maps'\n",
        ")\n",
        "\n",
