        "import folium\n",
        "from IPython.display import display\n",
        "import firebase_admin\n",
        "from firebase_admin import credentials, db\n",
        "\n",
        "# 1. Point to Google Drive folder\n",
        "base_dir = \"/content/drive/MyDrive/Thesis_Pothole_Project\"\n",
        "cred_path = f\"{base_dir}/Pothole_Simulation/credentials.json\"\n",
        "\n",
        "# 2. Connect to Firebase\n",
        "if not firebase_admin._apps:\n",
        "    cred = credentials.Certificate(cred_path)\n",
        "    firebase_admin.initialize_app(cred, {'databaseURL': 'YOUR_FIREBASE_URL'})\n",
        "\n",
        "# 3. Fetch Data from Realtime Database\n",
        "alerts_ref = db.reference('pothole_alerts')\n",
        "alerts_data = alerts_ref.get()\n",
        "\n",
        "# 4. Create the Folium Map\n",
        "# Center map on the default starting location (Kulim region)\n",
        "map_center = [5.3711, 100.5540]\n",
