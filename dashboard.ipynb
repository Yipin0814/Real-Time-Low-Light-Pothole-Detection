        "## Dashboard With Image"
      ],
      "metadata": {
        "id": "81Pw-jChqFj9"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import folium\n",
        "from IPython.display import display\n",
        "import firebase_admin\n",
        "from firebase_admin import credentials, db\n",
        "import branca\n",
        "\n",
        "# 1. Point to Google Drive folder\n",
        "base_dir = \"/content/drive/MyDrive/Thesis_Pothole_Project\"\n",
        "cred_path = f\"{base_dir}/Pothole_Simulation/credentials.json\"\n",
        "\n",
        "# 2. Connect to Firebase\n",
        "if not firebase_admin._apps:\n",
        "    cred = credentials.Certificate(cred_path)\n",
        "    firebase_admin.initialize_app(cred, {'databaseURL': '"YOUR_FIREBASE_URL"'})\n",
        "\n",
        "# 3. Fetch Data from Realtime Database\n",
        "alerts_ref = db.reference('pothole_alerts')\n",
        "alerts_data = alerts_ref.get()\n",
        "\n",
        "# 4. Create the Folium Map\n",
        "map_center = [5.3711, 100.5540]\n",
        "\n",
        "# Create a smaller window for the map\n",
        "fig = branca.element.Figure(width=\"70%\", height=\"600px\")\n",
        "\n",
        "# Using direct Google Maps tiles to avoid watermarks and 403 errors\n",
        "m = folium.Map(\n",
        "    location=map_center,\n",
        "    zoom_start=14,\n",
        "    tiles='https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}',\n",
        "    attr='Google Maps'\n",
        ")\n",
        "\n",
        "print(\"🚨 LIVE POTHOLE DETECTION DASHBOARD 🚨\\n\")\n",
        "\n",
        "# 5. Plot the Red Alert Pins\n",
        "if alerts_data:\n",
        "    print(f\"✅ SUCCESS: {len(alerts_data)} potholes detected in the database.\")\n",
        "\n",
        "    for key, data in alerts_data.items():\n",
        "        lat = data.get(\"lat\")\n",
        "        long = data.get(\"long\")\n",
        "        time_det = data.get(\"time\")\n",
        "        conf = data.get(\"confidence\")\n",
        "        img_b64 = data.get(\"image_b64\", \"\")  # Fetch base64 image string\n",
        "\n",
        "        # Custom HTML popup with image preview embedded\n",
        "        popup_html = f\"\"\"\n",
        "        <div style=\"font-family: Arial; min-width: 200px; text-align: center;\">\n",
        "            <h4 style=\"margin:0; color:#d9534f;\">⚠️ Pothole Alert</h4>\n",
        "            <hr style=\"margin:6px 0;\">\n",
        "            <b>Time:</b> {time_det}<br>\n",
        "            <b>Confidence:</b> {conf}%<br><br>\n",
        "            <img src=\"data:image/jpeg;base64,{img_b64}\" width=\"220\" style=\"border-radius: 5px;\"><br>\n",
        "        </div>\n",
        "        \"\"\"\n",
        "\n",
        "        folium.Marker(\n",
        "            location=[lat, long],\n",
        "            popup=folium.Popup(popup_html, max_width=300),\n",
        "            tooltip=f\"Pothole Detected ({conf}%)\",\n",
        "            icon=folium.Icon(color=\"red\", icon=\"info-sign\")\n",
        "        ).add_to(m)\n",
        "else:\n",
        "    print(\"ℹ️ Waiting for dashcam data... No potholes detected yet.\")\n",
        "\n",
        "fig.add_child(m)\n",
        "display(fig)"
      ],
